diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index 459f99f9..7a9e14c6 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -16,6 +16,8 @@
 #include <net/genetlink.h>
 #include <linux/moduleparam.h>
 #include <linux/mutex.h>
+#include <linux/kprobes.h>
+#include <linux/xarray.h>
 // security/selinux/include/security.h
 #include <security.h>
 #include <ss/context.h>
@@ -189,6 +191,7 @@ out:
 
 static int my_setprocattr(const char *name, void *value, size_t size);
 struct ksu_lsm_hook selinux_setprocattr_hook = KSU_LSM_HOOK_INIT(setprocattr, "selinux_setprocattr", my_setprocattr, 0);
+static void *orig_selinux_setprocattr;
 
 /*
  * get the security ID of a set of credentials
@@ -383,6 +386,213 @@ static int my_sel_open_handle_status(struct inode *inode, struct file *filp)
     return ret;
 }
 
+/*
+ * The pointer writes below are what a stock KernelSU does here, and on this
+ * target the kernel refuses them: the slots this feature patches -
+ * sel_handle_status_ops.open, write_op, the LSM table entry - live in the
+ * rodata range handed to the hypervisor at init, so ksu_patch_text() comes back
+ * with an error, and with -EOPNOTSUPP on a build that disables patching
+ * outright. A kprobe reaches the same call site from the other side: kprobe
+ * instruction pages are whitelisted with the hypervisor, so a breakpoint is
+ * accepted where a plain write is not. Every slot therefore tries the write
+ * first and diverts the handler it points at when the write is refused.
+ *
+ * Recursion guard: a replacement calls the original through the captured
+ * pointer, which is the probed address, so that nested call hits the same
+ * probe. The guard is keyed on the calling task rather than a global latch, so
+ * unrelated tasks never block each other, and a task that dies inside a
+ * replacement merely leaks one small xarray entry instead of wedging every
+ * later call into fail-open.
+ */
+static DEFINE_XARRAY(sel_hide_probe_guard);
+
+static bool sel_hide_guard_enter(void)
+{
+    void *old;
+
+    if (xa_load(&sel_hide_probe_guard, (unsigned long)current))
+        return false;
+    old = xa_store(&sel_hide_probe_guard, (unsigned long)current, current, GFP_KERNEL);
+    return !IS_ERR(old);
+}
+
+static void sel_hide_guard_exit(void)
+{
+    xa_erase(&sel_hide_probe_guard, (unsigned long)current);
+}
+
+static int __nocfi sel_hide_status_open_tramp(struct inode *inode, struct file *filp)
+{
+    int ret = my_sel_open_handle_status(inode, filp);
+    sel_hide_guard_exit();
+    return ret;
+}
+
+static ssize_t __nocfi sel_hide_write_context_tramp(struct file *file, char *buf, size_t size)
+{
+    ssize_t ret = my_write_context(file, buf, size);
+    sel_hide_guard_exit();
+    return ret;
+}
+
+static ssize_t __nocfi sel_hide_write_access_tramp(struct file *file, char *buf, size_t size)
+{
+    ssize_t ret = my_write_access(file, buf, size);
+    sel_hide_guard_exit();
+    return ret;
+}
+
+// Always divert: the fake status page has to be served to hidden apps and
+// lazily initialized even while the rest of the feature is disabled, exactly as
+// the permanently patched slot behaves.
+static int sel_hide_status_open_pre(struct kprobe *p, struct pt_regs *regs)
+{
