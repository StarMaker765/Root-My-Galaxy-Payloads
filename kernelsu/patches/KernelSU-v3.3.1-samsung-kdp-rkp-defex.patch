+}
+
+static int setresuid_return_handler(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct ksu_setresuid_task_work *work;
+    uid_t old_uid = *(uid_t *)ri->data;
+    uid_t new_uid;
